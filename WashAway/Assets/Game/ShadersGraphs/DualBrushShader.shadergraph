{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "efd57b4870d1479daf26d521f1c5869b",
    "m_Title": "",
    "m_Content": "Smooth step instead of lerp so the dapple map will still == 0 in the spots that are dappled (lerp will always increase the lowest value from up from zero)\n\nBasically, the closer edge 2 is to 1 the more input will come through, making dapple stronger. ",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -3454.39990234375,
        "y": 316.0,
